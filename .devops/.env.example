# Production environment (NEVER commit the real file: it holds the robot IP).
# Copy to .env and fill in: cp .env.example .env
# The launch fails fast if NAO_IP is empty (see production.compose.yml).

# Robot address on the lab network (no default on purpose).
NAO_IP=
# Rarely changed.
NAO_PORT=9559
# Must match every other participant in the DDS domain.
ROS_DOMAIN_ID=42
