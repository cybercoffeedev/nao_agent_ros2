{
    "name": "nao_agent_ros2 (CUDA)",
    // GPU passthrough via the `dev-cuda` compose service. Needs the NVIDIA
    // Container Toolkit on the host; the image carries the CUDA toolkit and
    // the first-create bootstrap enables the CUDA backends.
    "dockerComposeFile": [
        "../devcontainer.compose.yml"
    ],
    "service": "dev-cuda",
    "shutdownAction": "stopCompose",
    "remoteUser": "ros2dev",
    "workspaceFolder": "/home/ws/src/nao_agent_ros2",
    "customizations": {
        "vscode": {
            "extensions": [
                "Ranch-Hand-Robotics.rde-ros-2",
                "ms-python.python",
                "ms-python.debugpy",
                "redhat.vscode-xml",
                "bierner.markdown-mermaid"
            ]
        }
    },
    "postCreateCommand": "bash .devcontainer/setup-workspace.sh",
    "postStartCommand": "bash .devcontainer/start-sim.sh"
}
