{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NaoAgentResponse",
  "description": "Ordered action steps: speak steps say text, other steps run robot actions. Compiled to GBNF by llama_ros (sampling_config.grammar_schema).",
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": ["speak", "sit_down", "stand_up", "lie_on_stomach", "lie_on_back", "wave_right_hand"]
          },
          "text": {
            "type": "string",
            "description": "Spoken text, only meaningful for speak steps."
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    }
  },
  "required": ["actions"],
  "additionalProperties": false
}
